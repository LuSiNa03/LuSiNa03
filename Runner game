<svg viewBox="0 0 900 220" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0d1117"/>
      <stop offset="100%" stop-color="#0f2027"/>
    </linearGradient>

    <pattern id="ground" width="20" height="20" patternUnits="userSpaceOnUse">
      <rect width="20" height="20" fill="#3a2a1a"/>
      <rect width="20" height="6" fill="#39FF14"/>
      <rect x="0" y="6" width="10" height="4" fill="#2fcf10"/>
      <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="-20 0" dur="1s" repeatCount="indefinite"/>
    </pattern>

    <style>
      .sun { animation: pulse 2s ease-in-out infinite; transform-origin: 820px 40px; }
      @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.15); } }

      .cloud1 { animation: moveCloud 18s linear infinite; }
      .cloud2 { animation: moveCloud 26s linear infinite; }
      .cloud3 { animation: moveCloud 34s linear infinite; }
      @keyframes moveCloud {
        from { transform: translate(950px, 0); }
        to   { transform: translate(-200px, 0); }
      }

      .coin { animation: bob 0.9s ease-in-out infinite, spin 1.4s linear infinite; }
      .coin2 { animation-delay: 0.3s; }
      .coin3 { animation-delay: 0.6s; }
      @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
      @keyframes spin { 0% { transform: scaleX(1); } 50% { transform: scaleX(0.15); } 100% { transform: scaleX(1); } }

      .runner { animation: hop 0.5s steps(2) infinite; }
      @keyframes hop { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

      .legA { animation: legSwapA 0.3s steps(1) infinite; }
      .legB { animation: legSwapB 0.3s steps(1) infinite; }
      @keyframes legSwapA { 0%,49% { opacity: 1; } 50%,100% { opacity: 0; } }
      @keyframes legSwapB { 0%,49% { opacity: 0; } 50%,100% { opacity: 1; } }
    </style>
  </defs>

  <rect x="0" y="0" width="900" height="220" fill="url(#sky)"/>

  <circle class="sun" cx="820" cy="40" r="22" fill="#FFD700"/>

  <g class="cloud1" fill="#a9c9ff" opacity="0.7">
    <rect x="0" y="30" width="60" height="14"/>
    <rect x="10" y="20" width="30" height="10"/>
  </g>
  <g class="cloud2" fill="#a9c9ff" opacity="0.5">
    <rect x="0" y="70" width="80" height="16"/>
    <rect x="15" y="58" width="35" height="12"/>
  </g>
  <g class="cloud3" fill="#a9c9ff" opacity="0.6">
    <rect x="0" y="15" width="50" height="12"/>
  </g>

  <g class="coin" transform="translate(300,120)">
    <circle r="8" fill="#FFD700"/>
  </g>
  <g class="coin coin2" transform="translate(500,110)">
    <circle r="8" fill="#FFD700"/>
  </g>
  <g class="coin coin3" transform="translate(650,130)">
    <circle r="8" fill="#FFD700"/>
  </g>

  <g class="runner" transform="translate(150,120)">
    <rect x="-10" y="-30" width="20" height="20" fill="#39FF14"/>
    <rect x="-8" y="-10" width="16" height="14" fill="#FFD700"/>
    <rect class="legA" x="-9" y="4" width="6" height="12" fill="#39FF14"/>
    <rect class="legA" x="3" y="4" width="6" height="12" fill="#2fcf10"/>
    <rect class="legB" x="-9" y="4" width="6" height="10" fill="#2fcf10" transform="translate(0,2)"/>
    <rect class="legB" x="3" y="4" width="6" height="10" fill="#39FF14" transform="translate(0,-2)"/>
  </g>

  <rect x="0" y="188" width="900" height="32" fill="url(#ground)"/>
</svg>
